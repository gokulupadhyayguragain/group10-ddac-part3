# SafeTrace environment template.
#
# FINAL PRODUCTION RULE:
# Store every application value in AWS Secrets Manager JSON.
# This file must only contain the non-secret bootstrap pointer needed to fetch it.
#
# Production EC2:
#   1. Create Secrets Manager secret: safetrace/prod/app
#   2. Put all values from docs/10SECRETS_MANAGER_VALUES.md into that secret.
#   3. Copy this file to .env and set only the two values below.
#   4. Run: docker compose up --build -d
#
# Local development:
#   You can leave .env absent and run:
#   SAFETRACE_SECRET_ID= docker compose --profile local-db up --build -d

AWS_REGION=us-east-1
SAFETRACE_SECRET_ID=safetrace/prod/app

# Do not put these in .env for production:
# DATABASE_URL
# JWT_SECRET
# RESEND_API_KEY
# RESEND_FROM_EMAIL
# AUTH_VERIFICATION_TTL_MINUTES
# TRUST_PROXY
# FRONTEND_PUBLIC_URL
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# GOOGLE_OAUTH_CALLBACK_URL
# S3_BUCKET
# S3_PUBLIC_BASE_URL
# SIGHTING_EVENT_API_URL
# SIGHTING_EVENT_API_KEY
# SQS_QUEUE_URL
# SNS_TOPIC_ARN
#
# Local-only optional overrides, not needed for production:
# POSTGRES_DB=safetrace
# POSTGRES_USER=safetrace
# POSTGRES_PASSWORD=safetrace
# DATABASE_URL=postgresql://safetrace:safetrace@db:5432/safetrace
# JWT_SECRET=local-dev-only-change-before-cloud
# BACKEND_URL=http://backend:5000
# FRONTEND_PORT=3000
# BACKEND_PORT=5000
